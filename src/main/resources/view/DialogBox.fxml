<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>

<fx:root type="HBox" xmlns:fx="http://javafx.com/fxml"
         alignment="TOP_LEFT" spacing="8.0">
    <children>
        <ImageView fx:id="displayPicture" fitHeight="50.0" fitWidth="50.0"
                   pickOnBounds="true" preserveRatio="true" />
        <Label fx:id="dialog" wrapText="true" />
    </children>
    <padding>
        <Insets top="5.0" right="5.0" bottom="5.0" left="5.0" />
    </padding>
</fx:root>