<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="callie.ui.MainWindow">
    <children>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="ALWAYS"
                    prefHeight="480.0" prefWidth="640.0" AnchorPane.topAnchor="0.0"
                    AnchorPane.bottomAnchor="40.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <content>
                <VBox fx:id="dialogContainer" spacing="8.0" prefWidth="620.0" />
            </content>
        </ScrollPane>
        <HBox spacing="8.0" prefHeight="40.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
              AnchorPane.bottomAnchor="0.0">
            <children>
                <TextField fx:id="userInput" HBox.hgrow="ALWAYS" onAction="#handleUserInput" />
                <Button fx:id="sendButton" text="Send" onAction="#handleUserInput" />
            </children>
        </HBox>
    </children>
</AnchorPane>
